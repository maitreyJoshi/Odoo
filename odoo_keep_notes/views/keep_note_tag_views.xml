<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_keep_note_tag_form" model="ir.ui.view">
        <field name="name">keep.note.tag.form</field>
        <field name="model">keep.note.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_keep_note_tag_tree" model="ir.ui.view">
        <field name="name">keep.note.tag.tree</field>
        <field name="model">keep.note.tag</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="action_keep_note_tags" model="ir.actions.act_window">
        <field name="name">Labels</field>
        <field name="res_model">keep.note.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_keep_note_tags" name="Labels" parent="menu_keep_notes_root" action="action_keep_note_tags" sequence="30"/>
</odoo>
