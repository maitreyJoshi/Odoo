<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_keep_note_form" model="ir.ui.view">
        <field name="name">keep.note.form</field>
        <field name="model">keep.note</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <div class="d-flex justify-content-between align-items-center">
                            <h1 style="width: 100%;">
                                <field name="name" placeholder="Title" style="width: 100%;"/>
                            </h1>
                            <div class="ms-2">
                                <button name="action_toggle_pinned" type="object" icon="fa-thumb-tack" class="text-dark btn-link fs-2" title="Unpin" invisible="not is_pinned" style="padding: 0; border: none; background: transparent;"/>
                                <button name="action_toggle_pinned" type="object" icon="fa-thumb-tack" class="text-muted btn-link fs-2" title="Pin" invisible="is_pinned" style="padding: 0; border: none; background: transparent;"/>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="is_pinned" invisible="1"/>
                            <field name="is_trashed" widget="boolean_toggle" invisible="1"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="reminder_date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <group>
                        <field name="cover_image" widget="image" options="{'size': [50, 50]}"/>
                    </group>
                    <notebook>
                        <page string="Note">
                            <field name="description" placeholder="Take a note..." widget="html" options="{'collaborative': true}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_keep_note_tree" model="ir.ui.view">
        <field name="name">keep.note.tree</field>
        <field name="model">keep.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="stage_id" widget="badge"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="is_pinned" invisible="1"/>
                <button name="action_toggle_pinned" type="object" icon="fa-thumb-tack" class="text-dark" title="Unpin" invisible="not is_pinned"/>
                <button name="action_toggle_pinned" type="object" icon="fa-thumb-tack" class="text-muted" title="Pin" invisible="is_pinned"/>
                <field name="reminder_date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_keep_note_kanban" model="ir.ui.view">
        <field name="name">keep.note.kanban</field>
        <field name="model">keep.note</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" default_order="is_pinned desc, id desc">
                <field name="stage_id"/>
                <field name="id"/>
                <field name="name"/>
                <field name="color"/>
                <field name="tag_ids"/>
                <field name="description"/>
                <field name="is_pinned"/>
                <field name="is_trashed"/>
                <field name="reminder_date"/>
                <field name="cover_image"/>
                <field name="active"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable">
                            <a role="menuitem" type="edit" class="dropdown-item">Edit Note</a>
                        </t>
                        <t t-if="widget.deletable">
                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        </t>
                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                    </t>
                    <t t-name="kanban-box">
                        <div t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_global_click">
                            <t t-if="record.cover_image.raw_value">
                                <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('keep.note', 'cover_image', record.id.raw_value)}')"/>
                                <div class="o_kanban_image d-md-none" t-attf-style="background-image:url('#{kanban_image('keep.note', 'cover_image', record.id.raw_value)}')"/>
                            </t>
                            <div class="oe_kanban_content">
                                <div class="d-flex align-items-start justify-content-between">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <a type="object" name="action_toggle_pinned" class="text-reset" style="margin-left: 10px;" title="Pin Status">
                                        <i t-attf-class="fa fa-thumb-tack {{record.is_pinned.raw_value ? 'text-dark' : 'text-muted'}}" style="font-size: 16px; cursor: pointer;" title="Pin Note"/>
                                    </a>
                                </div>
                                <div class="text-muted o_kanban_record_subtitle mt-1" t-if="record.description.raw_value">
                                    <field name="description" widget="html"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <t t-if="record.reminder_date.raw_value"><span class="badge text-bg-warning ms-1"><field name="reminder_date" widget="date"/></span></t>
                                        <field name="user_id" widget="many2one_avatar_user" invisible="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_keep_note_search" model="ir.ui.view">
        <field name="name">keep.note.search</field>
        <field name="model">keep.note</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="tag_ids"/>
                <filter string="Pinned" name="pinned" domain="[('is_pinned', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]" context="{'active_test': False}"/>
                <group expand="0" string="Group By">
                    <filter string="Labels" name="group_by_tags" context="{'group_by': 'tag_ids'}"/>
                    <filter string="Pinned Status" name="group_by_pinned" context="{'group_by': 'is_pinned'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_keep_note_calendar" model="ir.ui.view">
        <field name="name">keep.note.calendar</field>
        <field name="model">keep.note</field>
        <field name="arch" type="xml">
            <calendar string="Notes" date_start="reminder_date" color="color" quick_create="0">
                <field name="name"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_keep_notes" model="ir.actions.act_window">
        <field name="name">Notes</field>
        <field name="res_model">keep.note</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_keep_note_search"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create your first keep note!
          </p>
          <p>
            Organize your ideas, tasks, and daily thoughts.
          </p>
        </field>
    </record>

    <record id="action_keep_notes_reminders" model="ir.actions.act_window">
        <field name="name">Reminders</field>
        <field name="res_model">keep.note</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('reminder_date', '!=', False)]</field>
        <field name="search_view_id" ref="view_keep_note_search"/>
    </record>

    <menuitem id="menu_keep_notes_root" name="Keep Notes" web_icon="odoo_keep_notes,static/description/icon.png" sequence="10"/>
    <menuitem id="menu_keep_notes" name="Notes" parent="menu_keep_notes_root" action="action_keep_notes" sequence="10"/>
    <menuitem id="menu_keep_notes_reminders" name="Reminders" parent="menu_keep_notes_root" action="action_keep_notes_reminders" sequence="20"/>
</odoo>
