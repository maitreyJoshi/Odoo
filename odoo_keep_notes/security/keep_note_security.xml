<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rule to ensure users only see their own notes -->
        <record id="rule_keep_note_personal" model="ir.rule">
            <field name="name">Personal Keep Notes</field>
            <field name="model_id" ref="model_keep_note"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_keep_note_tag_personal" model="ir.rule">
            <field name="name">Personal Keep Note Tags</field>
            <field name="model_id" ref="model_keep_note_tag"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
